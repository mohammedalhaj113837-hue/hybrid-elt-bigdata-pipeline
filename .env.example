# Copy this file to `.env` and adjust if needed (optional - defaults work locally).

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=midterm_data_pipeline2

# PySpark Master Configuration
# local[*] runs Spark on this machine. For a cluster use e.g. spark://172.22.144.1:7077
SPARK_MASTER=local[*]

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
